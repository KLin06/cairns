# Copy this file to .env and fill in real values before running
# `docker compose up`. See specs/007-docker-containerization/contracts/env-vars.md
# for the full contract this file documents.

# --- db service (official postgres image) ---
POSTGRES_USER=cairns
POSTGRES_PASSWORD=cairns
POSTGRES_DB=cairns

# --- server service ---
# Must reference the same user/password/db as above, host "db" is the
# compose service name, not localhost.
DATABASE_URL=postgresql://cairns:cairns@db:5432/cairns

# S3 location of condition_models.joblib (see contracts/s3-model-object.md)
MODEL_S3_BUCKET=
MODEL_S3_KEY=condition_models.joblib
AWS_REGION=us-east-1

# Only needed if not using an assumed IAM role (e.g. local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Origin the client is served from, added to the server's CORS allow-list
CLIENT_ORIGIN=http://localhost:8080

# --- client service (build-time only) ---
# Baked into the static build; only needs to differ from the default when
# the server isn't reachable at localhost:8000 from the browser.
VITE_API_BASE=http://localhost:8000
